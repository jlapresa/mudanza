{
  "name": "quum-mudanza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "importar": "tsx scripts/importar.ts",
    "cron": "tsx scripts/cron.ts",
