DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mudanza"
# Conexión directa (sin pool) para aplicar el esquema. En Neon, la variable que da la integración de Vercel.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/mudanza"
AUTH_SECRET="dev-secret-cambiar-en-produccion-0123456789"
AUTH_TRUST_HOST=true
# Inicio de sesión de prueba (solo desarrollo). En producción, quitar.
AUTH_DEV_LOGIN=1
DOMINIO_PERMITIDO="quum.com"
RESPONSABLES="responsable@quum.com"
APP_URL="http://localhost:3000"
ALMACEN_DIR="./datos/fotos"
# Correo con Resend. Vacío = los correos (y los códigos de acceso) se escriben en la consola.
RESEND_API_KEY=""
CORREO_REMITENTE="Mudanza Quum <mudanza@quum.com>"
# Fotos en Vercel Blob (privado). Vacío = carpeta local ALMACEN_DIR.
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET="dev-cron"
